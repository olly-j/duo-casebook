{
  "schemaVersion": 1,
  "spineVersion": "0.2.0",
  "ecosystemCatalog": ".spine/ecosystem.json",
  "project": {
    "name": "CASEBOOK",
    "slug": "casebook",
    "profile": [
      "core",
      "web-backend"
    ],
    "github": "olly-j/duo-casebook",
    "defaultBranch": "main",
    "canonicalBacklog": "docs/product-backlog.md"
  },
  "authorities": [
    "AGENTS.md",
    "docs/README.md",
    "docs/change-management.md",
    "docs/product-backlog.md",
    "docs/user-feedback.md",
    "docs/github-capabilities.md"
  ],
  "adapters": [
    "CLAUDE.md",
    "GEMINI.md",
    ".github/copilot-instructions.md"
  ],
  "requiredTools": [
    "git",
    "python3",
    "node"
  ],
  "checks": {
    "audit": [
      [
        "python3",
        "scripts/casebook_quality.py",
        "--mode",
        "audit"
      ]
    ],
    "verify": {
      "A": [
        [
          "node",
          "--check",
          "web/app.js"
        ],
        [
          "node",
          "--check",
          "web/glass.js"
        ],
        [
          "node",
          "--test",
          "tests/polish.test.cjs",
          "tests/ux-polish.test.cjs",
          "tests/ui-launch.test.cjs",
          "tests/ads.test.cjs",
          "tests/privacy-center.test.cjs",
          "tests/google-cmp-provider.test.cjs",
          "tests/cmp-bootstrap.test.cjs",
          "tests/glass.test.cjs"
        ]
      ],
      "B": [
        [
          "node",
          "--check",
          "web/app.js"
        ],
        [
          "node",
          "--check",
          "web/glass.js"
        ],
        [
          "node",
          "--test",
          "tests/polish.test.cjs",
          "tests/ux-polish.test.cjs",
          "tests/ui-launch.test.cjs",
          "tests/ads.test.cjs",
          "tests/privacy-center.test.cjs",
          "tests/google-cmp-provider.test.cjs",
          "tests/cmp-bootstrap.test.cjs",
          "tests/glass.test.cjs"
        ],
        [
          "python3",
          "scripts/run_browser_checks.py",
          "--functional"
        ]
      ],
      "C": [
        [
          "python3",
          "-m",
          "unittest",
          "tests.test_spine_runtime",
          "tests.test_spine_liveness",
          "tests.test_discovery",
          "tests.test_adsense_readiness"
        ],
        [
          "node",
          "--check",
          "web/app.js"
        ],
        [
          "node",
          "--check",
          "web/glass.js"
        ],
        [
          "node",
          "--test",
          "tests/polish.test.cjs",
          "tests/ux-polish.test.cjs",
          "tests/ui-launch.test.cjs",
          "tests/ads.test.cjs",
          "tests/privacy-center.test.cjs",
          "tests/google-cmp-provider.test.cjs",
          "tests/cmp-bootstrap.test.cjs",
          "tests/glass.test.cjs"
        ],
        [
          "python3",
          "scripts/run_browser_checks.py",
          "--all"
        ],
        [
          "python3",
          "scripts/casebook_quality.py",
          "--mode",
          "release"
        ]
      ]
    },
    "releaseReadOnly": [
      [
        "python3",
        "scripts/verify_deployment.py",
        "--allow-stale"
      ]
    ]
  },
  "verificationGuidance": {
    "A": [
      "Focused logic, data-contract or copy changes; run syntax and targeted unit checks."
    ],
    "B": [
      "User-facing catalogue, filter, comparison, image or data changes; add real browser interaction evidence."
    ],
    "C": [
      "Publication, data-model, deployment, dependency or governance changes; run the full viewport, photo and public-revision matrix."
    ]
  },
  "capabilityPolicy": {
    "default": "Tools and native AI capabilities are allowed within authorized scope.",
    "recommendationDuty": true,
    "scriptsAreExclusiveAllowList": false,
    "researchReadOnlyAllowed": true
  },
  "githubPolicy": {
    "authority": "docs/github-capabilities.md",
    "repository": "olly-j/duo-casebook",
    "releaseDecision": "not-applicable",
    "releaseAuthority": "supplemental",
    "automaticPublish": false,
    "immutableReleases": "recommended-when-releases-apply",
    "generatedNotes": "review-input-only",
    "actionsPinning": "full-commit-sha",
    "liveReviewChecks": []
  },
  "humanGates": [
    "production deployment or public release",
    "store submission, pricing, signing, entitlements, bundle identity, or privacy declarations",
    "destructive external mutation or deletion/disposition of durable evidence",
    "new recurring cost, external authority, or shared dependency",
    "pull-request merge unless explicitly delegated"
  ],
  "processReview": {
    "cadence": "quarterly and after material incidents",
    "metrics": [
      "lead time",
      "release preparation time",
      "escaped defects",
      "failed or retried stages",
      "human attention time",
      "cloud and CI usage",
      "process exceptions and recurring friction"
    ]
  },
  "adoption": {
    "upstreamRepository": "olly-j/ai-development-spine",
    "trackingRef": "main",
    "resolvedRevision": "9e46fbc159508002559c49993e3f91e3f0972061",
    "updatePolicy": "Reviewed project-specific pull request; never auto-merge or overwrite project authorities."
  }
}
